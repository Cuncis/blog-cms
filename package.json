{
  "name": "blog-cms",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "dev:api": "pnpm --filter api start:dev",
    "test:api": "pnpm --filter api test",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:studio": "pnpm --filter api prisma:studio",
    "db:reset": "pnpm --filter api prisma:reset",
    "db:seed-admin": "pnpm --filter api seed:admin"
  }
}
