NODE_ENV=development
PORT=3001

# Must match the credentials and port in the root .env / docker-compose.yml
DATABASE_URL="mysql://root:root@localhost:3308/blogcms"

# Origin of the Next.js frontend (CORS)
CORS_ORIGIN=http://localhost:3000

# Signs access tokens. Generate your own: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-48
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# How many reverse proxies (Nginx, load balancer) sit in front of the API. 0 = none (local dev).
TRUST_PROXY_HOPS=0

# Redis (must match the root .env)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis-dev-password

# S3-compatible storage. MinIO locally. For real AWS, leave S3_ENDPOINT empty
# and set S3_FORCE_PATH_STYLE=false (credentials then come from IAM, see the AWS project).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blogcms-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minio-dev-password
S3_FORCE_PATH_STYLE=true


# First administrator, used only by `pnpm db:seed-admin` (not read by the running API).
# Choose your own password (10-128 chars) in your local .env; never commit it.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
